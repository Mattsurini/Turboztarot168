# ---- Notion (server-only) ----
# Integration token (https://www.notion.so/my-integrations). If unset the site
# falls back to the seed data in lib/seed.ts on the read path.
NOTION_API_KEY=
# Data source (database) IDs used by Notion. Unset => Notion features back off.
# NOTION_SERVICES_DB is no longer needed: services use the 5 built-in data sources.
#NOTION_SERVICES_DB=
NOTION_CATEGORIES_DB=
NOTION_ARTICLES_DB=
NOTION_BOOKINGS_DB=

# ---- Admin auth (server-only) ----
# sha256 hex of the admin password.
ADMIN_PASSWORD_HASH=
# Any long random string; signs the admin session cookie.
ADMIN_COOKIE_SECRET=

# ---- Public (NEXT_PUBLIC_* is bundled into the client bundle) ----
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_LINE_OA_ID=
NEXT_PUBLIC_LINE_OA_URL=
NEXT_PUBLIC_ADMIN_USERNAME=
